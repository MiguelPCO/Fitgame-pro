# Supabase - Get these from supabase.com > Settings > API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Cloudflare Turnstile (CAPTCHA). Vacío = sin widget; ver SEGURIDAD-20260918.md
VITE_TURNSTILE_SITE_KEY=

# Strava (Fase 7). El client_id NO es secreto (va en la URL de autorización);
# el client_secret vive solo como secret de la Edge Function, nunca aquí.
# Ver supabase/functions/README.md.
VITE_STRAVA_CLIENT_ID=
